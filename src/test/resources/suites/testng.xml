<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression: test methods run in parallel, each with its own browser (ThreadLocal driver) -->
<suite name="Regression" parallel="methods" thread-count="4" data-provider-thread-count="4">
    <listeners>
        <listener class-name="com.amrmedhat.qa.listeners.RetryTransformer"/>
    </listeners>
    <test name="UI">
        <packages>
            <package name="com.amrmedhat.qa.tests"/>
        </packages>
    </test>
</suite>
