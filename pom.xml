<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.amrmedhat.qa</groupId>
    <artifactId>selenium-java-testng</artifactId>
    <version>1.0.0</version>
    <name>Selenium Java TestNG Framework</name>
    <description>UI test automation framework with Selenium WebDriver, Java and TestNG</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <selenium.version>4.53.0</selenium.version>
        <testng.version>7.12.0</testng.version>
        <slf4j.version>2.0.20</slf4j.version>
        <allure.version>3.1.1</allure.version>

        <!-- defaults, override with -Dbrowser=firefox -Dheadless=false -Dsuite=smoke.xml -->
        <suite>testng.xml</suite>
        <browser>chrome</browser>
        <headless>true</headless>
        <baseUrl>https://the-internet.herokuapp.com</baseUrl>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- pinned to 3.5.x: 3.6+ no longer supports TestNG suite XML files (see .github/dependabot.yml) -->
                <version>3.5.6</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>src/test/resources/suites/${suite}</suiteXmlFile>
                    </suiteXmlFiles>
                    <environmentVariables>
                        <!-- Selenium Manager: no usage statistics sent from test runs -->
                        <SE_AVOID_STATS>true</SE_AVOID_STATS>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <browser>${browser}</browser>
                        <headless>${headless}</headless>
                        <baseUrl>${baseUrl}</baseUrl>
                        <!-- Allure writes raw results here; the HTML report is generated from this folder -->
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
